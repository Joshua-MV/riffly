{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Riffly desktop permissions: SQLite database, files in the app's own data folder, save dialog.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "dialog:default",
    "dialog:allow-save"
  ]
}
