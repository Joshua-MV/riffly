# Copy to frontend/.env. EXPO_PUBLIC_* values are bundled into the app: never put real secrets here.
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Only if the backend sets API_KEY (deters casual misuse; it is visible inside the app).
# EXPO_PUBLIC_API_KEY=
