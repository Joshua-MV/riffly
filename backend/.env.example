# Copy to backend/.env. The server is stateless: no database, no permanent files.
APP_ENV=development
LOG_LEVEL=INFO

# In-flight uploads/MP3s only; wiped on startup and after the app collects them.
WORK_DIR=work
JOB_TTL_MINUTES=30
MAX_ACTIVE_JOBS=8

CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
MAX_UPLOAD_MB=50
MAX_DURATION_MINUTES=12
ANALYSIS_WORKERS=2
ANALYSIS_EXECUTOR=process

# Optional: require this key (X-API-Key header) when the server is reachable from the internet.
# Set the same value as EXPO_PUBLIC_API_KEY in frontend/.env.
# API_KEY=
