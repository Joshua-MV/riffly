# Copy to backend/.env. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO

# local = single developer user, no sign-in (refused when APP_ENV=production)
AUTH_MODE=local
DATA_DIR=data
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

MAX_UPLOAD_MB=50
MAX_DURATION_MINUTES=12
ANALYSIS_WORKERS=2
ANALYSIS_EXECUTOR=process

# Supabase (milestone 6). Free tier is sufficient.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=   # only for legacy HS256 projects; otherwise JWKS is used
